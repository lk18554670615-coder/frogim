# 复制为 .env.production，替换全部 REPLACE_WITH_*，权限设为 600，严禁提交到 Git。
DOMAIN=chat.example.com
TLS_EMAIL=ops@example.com
IM_ENV=production
LINLI_DATA_ROOT=/data/linli-im/data
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=10
IM_LOG_LEVEL=info
LOG_ARCHIVE_DIR=/data/linli-im/logs/archive
IM_REPLICAS=1

POSTGRES_DB=nexachat
POSTGRES_USER=nexachat
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
IM_DATABASE_URL=postgres://nexachat:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/nexachat?sslmode=disable
IM_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
IM_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
IM_ADMIN_EMAIL=ops@example.com
IM_ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_PASSWORD_HASH'
IM_ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET
IM_ADMIN_SHARED_KEY_ENABLED=false
# 用户 REST Access Token 只走 Authorization: Bearer；WebSocket 只走 POST /v1/ws/ticket 换取的一次性 ticket。
# 使用个推 RestAPI V2 时设为 getui，并替换下面三个占位值。
IM_GETUI_APP_ID=REPLACE_WITH_GETUI_APP_ID
IM_GETUI_APP_KEY=REPLACE_WITH_GETUI_APP_KEY
IM_GETUI_MASTER_SECRET=REPLACE_WITH_GETUI_MASTER_SECRET
# iOS PushKit 来电与个推并用时设为 getui_apns_voip；deploy.sh 会自动叠加 infra/compose.apns-voip.yaml。
# Apple .p8 只保存于主机受控目录，必须由容器 uid 或 gid 10001 持有、权限固定 0400/0440，禁止提交仓库。
IM_APNS_VOIP_KEY_ID=REPLACE_WITH_10_CHARACTER_KEY_ID
IM_APNS_VOIP_TEAM_ID=REPLACE_WITH_10_CHARACTER_TEAM_ID
IM_APNS_VOIP_BUNDLE_ID=com.linlitong.imapp
IM_APNS_VOIP_SANDBOX=false
APNS_VOIP_PRIVATE_KEY_HOST_FILE=/data/linli-im/shared/secrets/apns-auth-key.p8
IM_ACCESS_TTL=15m
IM_REFRESH_TTL=720h
IM_MEDIA_MAX_BYTES=104857600
IM_TRUST_PROXY=true
IM_CALL_INVITE_TTL=30s
# 填写自有 STUN/TURN 地址；生产环境禁止使用示例域名。
IM_RTC_STUN_URLS=stun:stun.example.com:3478
IM_RTC_TURN_URLS=turns:turn.example.com:5349?transport=tcp,turn:turn.example.com:3478?transport=udp
IM_RTC_TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
IM_RTC_TURN_CREDENTIAL=REPLACE_WITH_AT_LEAST_16_RANDOM_BYTES

# Root 仅供 minio-init、备份和管理；API 使用下方独立的 bucket-scoped 最小权限凭据。
MINIO_ROOT_USER=nexachat-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_OBJECT_STORAGE_PASSWORD
MINIO_APP_USER=linli-im-app
MINIO_APP_PASSWORD=REPLACE_WITH_RANDOM_OBJECT_STORAGE_APP_PASSWORD
IM_S3_BUCKET=nexachat-media
IM_S3_REGION=us-east-1
IM_S3_PUBLIC_ENDPOINT=storage.example.com
IM_S3_PUBLIC_SECURE=true

# HTTPS 网关用于对接外部短信服务商或自建推送网关。
IM_PUSH_PROVIDER=webhook
IM_PUSH_WEBHOOK_URL=https://push-gateway.example.com/v1/deliver
IM_PUSH_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES
IM_OTP_WEBHOOK_URL=https://otp-gateway.example.com/v1/send
IM_OTP_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d
# backup.sh 以 umask 077 写入 .incomplete-*，校验完成后原子发布最终时间戳目录。
BACKUP_DIR=/data/linli-im/backups
