# 复制为 .env.production，替换全部 REPLACE_WITH_*，权限设为 600，严禁提交到 Git。
DOMAIN=chat.example.com
TLS_EMAIL=ops@example.com
TERMS_URL=https://chat.example.com/legal/terms
PRIVACY_URL=https://chat.example.com/legal/privacy
IM_ENV=production
LINLI_DATA_ROOT=/data/linli-im/data
WUKONG_REQUIRE_1TIB_DISK=true
WUKONG_PERFORMANCE_EVIDENCE=/data/linli-im/load-evidence/release/summary.txt
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=10
IM_LOG_LEVEL=info
IM_HTTP_LOG_SUCCESS_SAMPLE_RATE=0.01
IM_WUKONG_INTERNAL_RATE_LIMIT_PER_MINUTE=120000
SERVER_CPU_LIMIT=2.0
SERVER_MEMORY_LIMIT=1g
SERVER_GO_MEMORY_LIMIT=768MiB
SERVER_GO_MAX_PROCS=2
CONTAINER_PIDS_LIMIT=256
CONTAINER_NOFILE_SOFT=65536
CONTAINER_NOFILE_HARD=65536
LOG_ARCHIVE_DIR=/data/linli-im/logs/archive
IM_REPLICAS=1

# WuKongIM 固定版本连接。5001/5300 和密钥仅在 Compose 内网使用，不暴露给客户端。
WUKONG_IMAGE=registry.example.com/linli/wukongim@sha256:REPLACE_WITH_PROMOTED_IMAGE_DIGEST
WUKONG_EXTERNAL_IP=REPLACE_WITH_PUBLIC_SERVER_IP
IM_WUKONG_MANAGER_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES
IM_WUKONG_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
IM_WUKONG_POLICY_SECRET=REPLACE_WITH_AN_INDEPENDENT_32_BYTE_RANDOM_SECRET
IM_WUKONG_TCP_URL=tcp://chat.example.com:5100
IM_WUKONG_WS_URL=wss://chat.example.com/im
# Detached manifests are signed with an offline Ed25519 release key. Never put
# the private key on the application server.
IM_WUKONG_PLUGIN_TRUSTED_KEYS=release-2026:REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY
IM_WUKONG_PLUGIN_ALLOWLIST=wk.plugin.im-policy,wk.plugin.REPLACE_WITH_APPROVED_PLUGIN
IM_WUKONG_PLUGIN_MAX_BYTES=67108864
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
IM_LIVEKIT_URL=wss://chat.example.com/rtc
IM_LIVEKIT_TOKEN_TTL=5m
IM_PROMETHEUS_URL=http://prometheus:9090

POSTGRES_DB=nexachat
POSTGRES_USER=nexachat
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
IM_DATABASE_URL=postgres://nexachat:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/nexachat?sslmode=disable
IM_DB_MAX_CONNS=20
IM_DB_MIN_CONNS=2
IM_DB_MAX_CONN_LIFETIME=1h
IM_DB_MAX_CONN_IDLE_TIME=15m
IM_DB_HEALTH_CHECK_PERIOD=1m
IM_DB_STATEMENT_TIMEOUT=15s
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_LOG_MIN_DURATION_MS=500
IM_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
IM_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# 仅管理员表为空时用于初始化首个账号；已有管理员数据时可同时留空。
IM_ADMIN_USERNAME=admin
IM_ADMIN_CONTACT_EMAIL=ops@example.com
IM_ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_PASSWORD_HASH'
# 用户 REST Access Token 只走 Authorization: Bearer；WuKongIM 使用 /v2/auth/im-session 返回的独立 IM Token。
# 使用个推 RestAPI V2 时设为 getui，并替换下面三个占位值。
IM_GETUI_APP_ID=REPLACE_WITH_GETUI_APP_ID
IM_GETUI_APP_KEY=REPLACE_WITH_GETUI_APP_KEY
IM_GETUI_MASTER_SECRET=REPLACE_WITH_GETUI_MASTER_SECRET
IM_WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
IM_WEB_PUSH_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
IM_WEB_PUSH_SUBJECT=https://chat.example.com
# iOS PushKit 来电与个推并用时设为 getui_apns_voip；deploy.sh 会自动叠加 infra/compose.apns-voip.yaml。
# Apple .p8 只保存于主机受控目录，必须由容器 uid 或 gid 10001 持有、权限固定 0400/0440，禁止提交仓库。
IM_APNS_VOIP_KEY_ID=REPLACE_WITH_10_CHARACTER_KEY_ID
IM_APNS_VOIP_TEAM_ID=REPLACE_WITH_10_CHARACTER_TEAM_ID
IM_APNS_VOIP_BUNDLE_ID=com.fd.kuailiao
IM_APNS_VOIP_SANDBOX=false
APNS_VOIP_PRIVATE_KEY_HOST_FILE=/data/linli-im/shared/secrets/apns-auth-key.p8
IM_ACCESS_TTL=15m
IM_REFRESH_TTL=720h
IM_MEDIA_MAX_BYTES=104857600
IM_TRUST_PROXY=true
IM_CALL_INVITE_TTL=30s
IM_PUSH_WORKERS=16
IM_PUSH_BATCH_SIZE=200
IM_MESSAGE_FANOUT_BATCH_SIZE=500
IM_RUNTIME_CLEANUP_INTERVAL=1h
IM_OUTBOX_RETENTION=168h
REDIS_MAXMEMORY=384mb
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
# Root 仅供 minio-init、备份和管理；API 使用下方独立的 bucket-scoped 最小权限凭据。
MINIO_ROOT_USER=nexachat-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_OBJECT_STORAGE_PASSWORD
MINIO_APP_USER=linli-im-app
MINIO_APP_PASSWORD=REPLACE_WITH_RANDOM_OBJECT_STORAGE_APP_PASSWORD
IM_S3_BUCKET=nexachat-media
IM_S3_REGION=us-east-1
IM_S3_PUBLIC_ENDPOINT=storage.example.com
IM_S3_PUBLIC_SECURE=true

# HTTPS 网关用于对接外部短信服务商或自建推送网关。
IM_PUSH_PROVIDER=webhook
IM_PUSH_WEBHOOK_URL=https://push-gateway.example.com/v1/deliver
IM_PUSH_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES
IM_OTP_WEBHOOK_URL=https://otp-gateway.example.com/v1/send
IM_OTP_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d
# backup.sh 以 umask 077 写入 .incomplete-*，校验完成后原子发布最终时间戳目录。
BACKUP_DIR=/data/linli-im/backups
BACKUP_METRICS_DIR=/data/linli-im/backups/.metrics
# 异地目标需单独审批；启用后本地成功但异地复制失败仍视为整次任务失败。
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_PREFIX=linli-im
