# 本地前端远程联调配置：复制为 .env.remote-test 后使用。
# 这里只保存公开访问地址；密码、Token、推送密钥等禁止写入前端环境变量。
REMOTE_SERVER_ORIGIN=https://203.0.113.10
REMOTE_API_BASE_URL=https://203.0.113.10
REMOTE_WS_URL=wss://203.0.113.10/v1/ws

# 本地只暴露前端端口，后端、数据库、对象存储和 TURN 均使用远端资源。
WEB_PORT=8093
ADMIN_PORT=8088

# Docker 日志轮转，避免长期联调占满磁盘。
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
