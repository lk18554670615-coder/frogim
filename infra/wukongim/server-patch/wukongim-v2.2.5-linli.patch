index 0000000..1b0c8eb
--- /dev/null
+++ b/internal/plugin/runtime_log_linli_patch_test.go
@@ -0,0 +1,60 @@
+package plugin
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRuntimeLogStoreRetainsBoundedTailAndStreams(t *testing.T) {
+	store := newRuntimeLogStore(3, 1024)
+	stdout := store.Writer("plugin.wkp", "stdout")
+	stderr := store.Writer("plugin.wkp", "stderr")
+	_, _ = stdout.Write([]byte("one\ntwo\n"))
+	_, _ = stderr.Write([]byte("three\nfour\n"))
+	entries := store.Get("plugin.wkp", 500)
+	require.Len(t, entries, 3)
+	require.Equal(t, "two", entries[0].Message)
+	require.Equal(t, "stderr", entries[1].Stream)
+	require.Equal(t, "four", entries[2].Message)
+	require.Less(t, entries[0].Sequence, entries[2].Sequence)
+}
+
+func TestRuntimeLogStoreRedactsSecretsAndNormalizesControls(t *testing.T) {
+	store := newRuntimeLogStore(10, 1024)
+	writer := store.Writer("plugin.wkp", "stdout")
+	_, _ = writer.Write([]byte("token=abc123 password: hunter2 authorization: Bearer jwt-value\x00\n"))
+	entries := store.Get("plugin.wkp", 1)
+	require.Len(t, entries, 1)
+	require.NotContains(t, entries[0].Message, "abc123")
+	require.NotContains(t, entries[0].Message, "hunter2")
+	require.NotContains(t, entries[0].Message, "jwt-value")
+	require.NotContains(t, entries[0].Message, "\x00")
+}
+
+func TestRuntimeLogStoreConcurrentWritesAndLimit(t *testing.T) {
+	store := newRuntimeLogStore(1000, 256*1024)
+	var wg sync.WaitGroup
+	for streamIndex := 0; streamIndex < 8; streamIndex++ {
+		wg.Add(1)
+		go func(index int) {
+			defer wg.Done()
+			writer := store.Writer("plugin.wkp", fmt.Sprintf("stream-%d", index))
+			for line := 0; line < 20; line++ {
+				_, _ = fmt.Fprintf(writer, "%d-%d\n", index, line)
+			}
+		}(streamIndex)
+	}
+	wg.Wait()
+	require.Len(t, store.Get("plugin.wkp", 25), 25)
+	require.Empty(t, store.Get("missing.wkp", 25))
+}
+
+func TestRuntimeLogStoreDelete(t *testing.T) {
+	store := newRuntimeLogStore(10, 1024)
+	_, _ = store.Writer("plugin.wkp", "stdout").Write([]byte("line\n"))
+	store.Delete("plugin.wkp")
+	require.Empty(t, store.Get("plugin.wkp", 10))
+}
