@@ -0,0 +1,26 @@
+package eventbus
+
+import (
+	"strings"
+	"testing"
+
+	wkproto "github.com/WuKongIM/WuKongIMGoProto"
+)
+
+func TestConnStringNeverIncludesSessionEncryptionMaterial(t *testing.T) {
+	conn := &Conn{
+		Uid: "user-a", DeviceId: "device-a", ConnId: 42, NodeId: 1001,
+		DeviceFlag: wkproto.APP, DeviceLevel: wkproto.DeviceLevelMaster,
+		Auth: true, ProtoVersion: 4,
+		AesIV: []byte("sentinel-aes-iv"), AesKey: []byte("sentinel-aes-key"),
+	}
+	value := conn.String()
+	for _, secret := range []string{"sentinel-aes-iv", "sentinel-aes-key", "AesIV", "AesKey"} {
+		if strings.Contains(value, secret) {
+			t.Fatalf("connection string leaked %q: %s", secret, value)
+		}
+	}
+	if !strings.Contains(value, "ConnId:42") || !strings.Contains(value, "Uid:user-a") {
+		t.Fatalf("connection diagnostics were lost: %s", value)
+	}
+}
