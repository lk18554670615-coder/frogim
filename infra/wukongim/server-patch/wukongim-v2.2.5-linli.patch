@@ -0,0 +1,61 @@
+package wkcache
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMessageEventCacheSnapshotReplacesPriorDeltas(t *testing.T) {
+	cache := NewMessageEventCache(nil)
+	defer cache.Close()
+
+	_, err := cache.UpsertSession(MessageEventSessionMeta{ClientMsgNo: "snapshot-replace", ChannelId: "channel", ChannelType: 1}, "main", 0)
+	require.NoError(t, err)
+	_, err = cache.AppendDelta("snapshot-replace", "channel", 1, "main", "d1", "stream.delta", "public", 1, []byte(`{"kind":"text","delta":"old"}`))
+	require.NoError(t, err)
+	state, err := cache.ReplaceSnapshot("snapshot-replace", "channel", 1, "main", "s1", "stream.snapshot", "public", 2, []byte(`{"kind":"text","text":"replacement"}`))
+	require.NoError(t, err)
+	require.True(t, state.HasTextSnapshot)
+	require.Equal(t, "replacement", state.TextSnapshot)
+	_, err = cache.AppendDelta("snapshot-replace", "channel", 1, "main", "d2", "stream.delta", "public", 3, []byte(`{"kind":"text","delta":" after"}`))
+	require.NoError(t, err)
+
+	payload, _, err := cache.BuildTerminalPayload("snapshot-replace", "channel", 1, "main", []byte(`{"end_reason":0}`), "close", "stream.close", "public", 4)
+	require.NoError(t, err)
+	var body map[string]any
+	require.NoError(t, json.Unmarshal(payload, &body))
+	snapshot := body["snapshot"].(map[string]any)
+	require.Equal(t, "replacement after", snapshot["text"])
+}
+
+func TestMessageEventCacheEmptyTextSnapshotIsAuthoritative(t *testing.T) {
+	cache := NewMessageEventCache(nil)
+	defer cache.Close()
+	_, err := cache.UpsertSession(MessageEventSessionMeta{ClientMsgNo: "snapshot-empty", ChannelId: "channel", ChannelType: 1}, "main", 0)
+	require.NoError(t, err)
+	_, err = cache.AppendDelta("snapshot-empty", "channel", 1, "main", "d1", "stream.delta", "public", 1, []byte(`{"kind":"text","delta":"discard me"}`))
+	require.NoError(t, err)
+	_, err = cache.ReplaceSnapshot("snapshot-empty", "channel", 1, "main", "s1", "stream.snapshot", "public", 2, []byte(`{"kind":"text","text":""}`))
+	require.NoError(t, err)
+	payload, _, err := cache.BuildTerminalPayload("snapshot-empty", "channel", 1, "main", []byte(`{"end_reason":0}`), "close", "stream.close", "public", 3)
+	require.NoError(t, err)
+	var body map[string]any
+	require.NoError(t, json.Unmarshal(payload, &body))
+	require.Equal(t, "", body["snapshot"].(map[string]any)["text"])
+}
+
+func TestMessageEventCacheNonTextSnapshotReplacesText(t *testing.T) {
+	cache := NewMessageEventCache(nil)
+	defer cache.Close()
+	_, err := cache.UpsertSession(MessageEventSessionMeta{ClientMsgNo: "snapshot-raw", ChannelId: "channel", ChannelType: 1}, "main", 0)
+	require.NoError(t, err)
+	_, err = cache.AppendDelta("snapshot-raw", "channel", 1, "main", "d1", "stream.delta", "public", 1, []byte(`{"kind":"text","delta":"discard me"}`))
+	require.NoError(t, err)
+	state, err := cache.ReplaceSnapshot("snapshot-raw", "channel", 1, "main", "s1", "stream.snapshot", "public", 2, []byte(`{"kind":"tool_result","value":"ok"}`))
+	require.NoError(t, err)
+	require.False(t, state.HasTextSnapshot)
+	require.Empty(t, state.TextSnapshot)
+	require.JSONEq(t, `{"kind":"tool_result","value":"ok"}`, string(state.SnapshotPayload))
+}
