+	}
+	if limit > 500 {
+		limit = 500
+	}
+	c.JSON(http.StatusOK, gin.H{
+		"plugin_no": plugin.No,
+		"node_id":   nodeId,
+		"entries":   s.runtimeLogs.Get(plugin.Name, limit),
+	})
