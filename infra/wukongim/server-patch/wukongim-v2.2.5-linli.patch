diff --git a/internal/plugin/runtime_log.go b/internal/plugin/runtime_log.go
new file mode 100755
index 0000000..b75d527
--- /dev/null
+++ b/internal/plugin/runtime_log.go
@@ -0,0 +1,140 @@
+package plugin
+
+import (
+	"bytes"
+	"io"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+)
+
+const maxRuntimeLogLineBytes = 4096
+
+var (
+	authorizationLogSecret = regexp.MustCompile(`(?i)(authorization\s*[:=]\s*(?:bearer\s+)?)[^\s,;]+`)
+	namedLogSecret         = regexp.MustCompile(`(?i)((?:token|secret|password|api[_-]?key)\s*[:=]\s*)[^\s,;]+`)
+)
+
+type runtimeLogEntry struct {
+	Sequence  uint64 `json:"sequence"`
+	Stream    string `json:"stream"`
+	Timestamp int64  `json:"timestamp"`
+	Message   string `json:"message"`
+}
+
+type runtimeLogBuffer struct {
+	entries []runtimeLogEntry
+	bytes   int
+}
+
+type runtimeLogStore struct {
+	mu         sync.Mutex
+	buffers    map[string]*runtimeLogBuffer
+	nextSeq    uint64
+	maxEntries int
+	maxBytes   int
+}
+
+func newRuntimeLogStore(maxEntries, maxBytes int) *runtimeLogStore {
+	return &runtimeLogStore{buffers: make(map[string]*runtimeLogBuffer), maxEntries: maxEntries, maxBytes: maxBytes}
+}
+
+func (s *runtimeLogStore) Writer(name, stream string) io.Writer {
+	return &runtimeLogWriter{store: s, name: name, stream: stream}
+}
+
+func (s *runtimeLogStore) append(name, stream, message string) {
+	name = strings.TrimSpace(name)
+	if name == "" {
+		return
+	}
+	message = sanitizeRuntimeLogMessage(message)
+	if message == "" {
+		return
+	}
+	if len(message) > maxRuntimeLogLineBytes {
+		message = message[:maxRuntimeLogLineBytes] + "…"
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.nextSeq++
+	buffer := s.buffers[name]
+	if buffer == nil {
+		buffer = &runtimeLogBuffer{}
+		s.buffers[name] = buffer
+	}
+	entry := runtimeLogEntry{Sequence: s.nextSeq, Stream: stream, Timestamp: time.Now().UnixMilli(), Message: message}
+	buffer.entries = append(buffer.entries, entry)
+	buffer.bytes += len(message)
+	for len(buffer.entries) > s.maxEntries || buffer.bytes > s.maxBytes {
+		buffer.bytes -= len(buffer.entries[0].Message)
+		buffer.entries = buffer.entries[1:]
+	}
+}
+
+func (s *runtimeLogStore) Get(name string, limit int) []runtimeLogEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if limit <= 0 || limit > 500 {
+		limit = 100
+	}
+	buffer := s.buffers[name]
+	if buffer == nil || len(buffer.entries) == 0 {
+		return []runtimeLogEntry{}
+	}
+	start := len(buffer.entries) - limit
+	if start < 0 {
+		start = 0
+	}
+	result := make([]runtimeLogEntry, len(buffer.entries)-start)
+	copy(result, buffer.entries[start:])
+	return result
+}
+
+func (s *runtimeLogStore) Delete(name string) {
+	s.mu.Lock()
+	delete(s.buffers, name)
+	s.mu.Unlock()
+}
+
+type runtimeLogWriter struct {
+	mu      sync.Mutex
+	store   *runtimeLogStore
+	name    string
+	stream  string
+	pending []byte
+}
+
+func (w *runtimeLogWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.pending = append(w.pending, p...)
+	for {
+		newline := bytes.IndexByte(w.pending, '\n')
+		if newline < 0 {
+			if len(w.pending) <= maxRuntimeLogLineBytes {
+				break
+			}
+			w.store.append(w.name, w.stream, string(w.pending[:maxRuntimeLogLineBytes]))
+			w.pending = w.pending[maxRuntimeLogLineBytes:]
+			continue
+		}
+		w.store.append(w.name, w.stream, string(w.pending[:newline]))
+		w.pending = w.pending[newline+1:]
+	}
+	return len(p), nil
+}
+
+func sanitizeRuntimeLogMessage(message string) string {
+	message = strings.TrimSpace(strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) && r != '\t' {
+			return -1
+		}
+		return r
+	}, message))
+	message = authorizationLogSecret.ReplaceAllString(message, `${1}******`)
+	return namedLogSecret.ReplaceAllString(message, `${1}******`)
+}
diff --git a/internal/plugin/runtime_log_linli_patch_test.go b/internal/plugin/runtime_log_linli_patch_test.go
