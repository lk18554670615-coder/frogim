+package api
+
+import (
+	"testing"
+
+	wkproto "github.com/WuKongIM/WuKongIMGoProto"
+)
+
+func TestCommunityTopicChannelIDValidation(t *testing.T) {
+	valid := []string{"community@topic", " community @ topic "}
+	for _, channelID := range valid {
+		if invalidChannelID(channelID, wkproto.ChannelTypeCommunityTopic) {
+			t.Fatalf("expected community topic channel ID %q to be valid", channelID)
+		}
+	}
+
+	invalid := []string{"community", "@topic", "community@", "community@topic@extra", "community#one@topic", "community@topic&one"}
+	for _, channelID := range invalid {
+		if !invalidChannelID(channelID, wkproto.ChannelTypeCommunityTopic) {
+			t.Fatalf("expected community topic channel ID %q to be invalid", channelID)
+		}
+	}
+}
+
+func TestNonCommunityTopicChannelIDValidationIsUnchanged(t *testing.T) {
+	if !invalidChannelID("group@topic", wkproto.ChannelTypeGroup) {
+		t.Fatal("non-community channel IDs must continue to reject @")
+	}
+	if invalidChannelID("group-topic", wkproto.ChannelTypeGroup) {
+		t.Fatal("ordinary non-community channel ID should remain valid")
+	}
+}
+
+func TestCommunityTopicChecksUseScopedValidation(t *testing.T) {
+	const channelID = "community@topic"
+	const channelType = wkproto.ChannelTypeCommunityTopic
+	if err := (channelCreateReq{channelInfoReq: channelInfoReq{ChannelID: channelID, ChannelType: channelType}}).Check(); err != nil {
+		t.Fatalf("channel create rejected valid community topic: %v", err)
+	}
+	if err := (subscriberAddReq{ChannelId: channelID, ChannelType: channelType, Subscribers: []string{"u1"}}).Check(); err != nil {
+		t.Fatalf("subscriber add rejected valid community topic: %v", err)
+	}
+	if err := (subscriberRemoveReq{ChannelId: channelID, ChannelType: channelType, Subscribers: []string{"u1"}}).Check(); err != nil {
+		t.Fatalf("subscriber remove rejected valid community topic: %v", err)
+	}
+	if err := (whitelistReq{ChannelId: channelID, ChannelType: channelType, UIDs: []string{"u1"}}).Check(); err != nil {
+		t.Fatalf("whitelist rejected valid community topic: %v", err)
+	}
+}
