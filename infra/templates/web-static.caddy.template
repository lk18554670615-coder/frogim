    handle_path /app/* {
      root * /srv/web
      @versioned path_regexp ^/releases/[a-f0-9]{16}/
      handle @versioned {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
          precompressed gzip
        }
      }
      @workers path /flutter_service_worker.js /linli_push_worker.js
      handle @workers {
        header Cache-Control "no-store"
        file_server
      }
      handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server {
          precompressed gzip
        }
      }
    }
