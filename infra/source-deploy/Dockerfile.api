FROM golang:1.26-alpine AS go
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/im-server ./cmd/server \
 && CGO_ENABLED=0 go build -trimpath -o /out/setup ./cmd/light-tenancy-import \
 && go run ./cmd/prepare-ipregion -out /out/ipregion
WORKDIR /src/plugin
COPY tools/wukong-policy-plugin/go.mod tools/wukong-policy-plugin/go.sum ./
RUN go mod download
COPY tools/wukong-policy-plugin/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/policy.wkp .

FROM node:22-alpine AS ui
WORKDIR /src
COPY apps/admin/package*.json ./
RUN npm ci
COPY apps/admin/ ./
RUN VITE_PLATFORM_MODE=true npm run build -- --base=/platform/ --outDir=/out/platform \
 && VITE_PLATFORM_MODE=false VITE_ADMIN_API_URL=/api/v2/admin npm run build -- --base=/admin/ --outDir=/out/enterprise

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=go /out/im-server /opt/frogim/im-server
COPY --from=go /out/setup /opt/frogim/setup
COPY --from=go /out/policy.wkp /opt/frogim/policy.wkp
COPY --from=go /out/ipregion /opt/ip2region
COPY --from=ui /out/platform /srv/platform
COPY --from=ui /out/enterprise /srv/admin
ENV IM_IP_REGION_DIR=/opt/ip2region
USER 0:0
ENTRYPOINT ["/opt/frogim/im-server"]
