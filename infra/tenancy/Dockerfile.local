# Local binaries are cross-compiled by start-tenancy-local.ps1 from this tree.
# No remote application image or production credential is used.
FROM alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN addgroup -S -g 10001 im && adduser -S -D -H -u 10001 -G im im
COPY build/tenancy-local/bin/ /opt/frogim/
RUN chmod 0555 /opt/frogim/*
USER im:im
ENTRYPOINT ["/opt/frogim/platform"]
