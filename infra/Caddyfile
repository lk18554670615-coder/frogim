{
	email {$TLS_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	@backend path /v1/* /api/* /health
	handle @backend {
		reverse_proxy {
			dynamic a server 8080 {
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			lb_try_interval 250ms
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /web {
		redir /web/ permanent
	}

	handle_path /web/* {
		reverse_proxy web:8080 {
			health_uri /healthz
			health_interval 15s
			health_timeout 3s
		}
	}

	handle {
		reverse_proxy admin:8080 {
			health_uri /healthz
			health_interval 15s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format filter {
			request>uri query {
				replace ticket REDACTED
				replace token REDACTED
			}
			wrap json
		}
	}
}
