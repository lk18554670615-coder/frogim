# 仅用于本地开发。生产环境使用 .env.production，详见 docs/CONFIGURATION_ZH.md。
IM_ADDR=:8080
IM_ENV=development
IM_HTTP_RATE_LIMIT_PER_MINUTE=30000
IM_DEV_MODE=true
IM_DEV_ALLOW_CONTAINER_BIND=true
# 默认不创建 Alice/Bob 等演示账号；仅隔离开发测试需要时显式改为 true。
IM_SEED_DEMO=false
# 仅本机 Docker 验收使用；生产必须为 false。
IM_IP_TEST_ONLY=true
IM_DEV_OTP_CODE=123456
IM_GETUI_APP_ID=
IM_GETUI_APP_KEY=
IM_GETUI_MASTER_SECRET=
IM_APNS_VOIP_KEY_ID=
IM_APNS_VOIP_TEAM_ID=
IM_APNS_VOIP_BUNDLE_ID=com.fd.kuailiao
IM_APNS_VOIP_PRIVATE_KEY_FILE=
IM_APNS_VOIP_SANDBOX=true
IM_DATABASE_URL=postgres://nexachat:nexachat@postgres:5432/nexachat?sslmode=disable
IM_REDIS_URL=redis://:local-redis-password@redis:6379/0
IM_JWT_SECRET=local-development-jwt-secret-change-me
# 数据库管理员表为空时仅初始化一次：admin / local-development-admin-password
# 初始化完成后，这些环境变量不再参与后台登录验证。
IM_ADMIN_USERNAME=admin
IM_ADMIN_CONTACT_EMAIL=
IM_ADMIN_PASSWORD_HASH='$2a$12$rAyv6obDffJSqZ1aaqOCR.ER2UXp8ZPsEl2bJCTovnsJJrFshtxNW'
IM_PUSH_PROVIDER=log
IM_ACCESS_TTL=15m
IM_REFRESH_TTL=720h
IM_CALL_INVITE_TTL=30s

# Optional local signed-plugin lifecycle. Set all three values together.
# Trusted keys format: key-id:base64-ed25519-public-key[,key-id:...]
IM_WUKONG_PLUGIN_DIR=
IM_WUKONG_PLUGIN_TRUSTED_KEYS=
IM_WUKONG_PLUGIN_ALLOWLIST=
IM_WUKONG_PLUGIN_MAX_BYTES=67108864

POSTGRES_DB=nexachat
POSTGRES_USER=nexachat
POSTGRES_PASSWORD=nexachat
REDIS_PASSWORD=local-redis-password
MINIO_ROOT_USER=nexachat
MINIO_ROOT_PASSWORD=local-minio-password
IM_S3_BUCKET=nexachat-media

SERVER_PORT=8080
WEB_PORT=8090
ADMIN_PORT=8088
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
